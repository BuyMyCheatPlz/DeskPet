<Window x:Class="DeskPet.Shell.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat with your pet"
        Width="380" Height="540"
        MinWidth="320" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E"
        Foreground="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF2A2A2C" Padding="12,8">
            <TextBlock Text="🐾 Your pet (AI)" FontSize="14" FontWeight="SemiBold" />
        </Border>

        <ScrollViewer x:Name="MsgScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
            <StackPanel x:Name="MsgPanel" />
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FF2A2A2C" Padding="8">
            <DockPanel>
                <Button x:Name="SendBtn" Content="Send" DockPanel.Dock="Right"
                        Width="64" Height="30" Margin="8,0,0,0"
                        Background="#FF5C8AD6" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="Send_Click" />
                <TextBox x:Name="InputBox" DockPanel.Dock="Left"
                         Background="#FF111111" Foreground="White" BorderThickness="0"
                         Padding="8,6" VerticalContentAlignment="Center"
                         TextWrapping="Wrap" AcceptsReturn="False"
                         KeyDown="InputBox_KeyDown" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
