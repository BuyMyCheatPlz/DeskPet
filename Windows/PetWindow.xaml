<Window x:Class="DeskPet.Shell.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False">
    <Grid Background="{x:Null}">
        <Grid.RowDefinitions>
            <RowDefinition Height="110" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="ActionPanel"
                Grid.Row="0"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,4,0,0"
                Visibility="Collapsed"
                Background="#E61C1C1E"
                CornerRadius="12"
                BorderBrush="#33FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.4" />
            </Border.Effect>
            <StackPanel Margin="8,8">
                <TextBlock x:Name="StatsText"
                           Foreground="White"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="😺 ❤️ 100%  ✨ 100%" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button x:Name="PetButton" Click="PetButton_Click"
                            Content="抚摸" Width="44" Height="28" Margin="0,0,4,0"
                            Background="#FF5C8AD6" Foreground="White" BorderThickness="0"
                            FontSize="11" Cursor="Hand" />
                    <Button x:Name="ChatButton" Click="ChatButton_Click"
                            Content="对话" Width="44" Height="28" Margin="0,0,4,0"
                            Background="#FF7A5CD6" Foreground="White" BorderThickness="0"
                            FontSize="11" Cursor="Hand" />
                    <Button x:Name="HomeButton" Click="HomeButton_Click"
                            Content="回巢" Width="44" Height="28"
                            Background="#33333333" Foreground="White" BorderThickness="0"
                            FontSize="11" Cursor="Hand" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Image x:Name="FrameImage"
               Grid.Row="1"
               Stretch="Uniform"
               RenderTransformOrigin="0.5,0.5"
               Cursor="Hand" />

        <!-- Speech bubble: shows AI replies above the pet's head. -->
        <Border x:Name="SpeechBubble"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,2,0,0"
                MaxWidth="300"
                Visibility="Collapsed"
                Background="#F21E1E22"
                CornerRadius="12"
                BorderBrush="#55FFFFFF"
                BorderThickness="1"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="SpeechText"
                           Foreground="White"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Padding="10,7"
                           Text="…" />
                <Path Width="16" Height="8" Fill="#F21E1E22"
                      Data="M 0,0 L 16,0 L 8,8 Z"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Stretch="Fill" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
