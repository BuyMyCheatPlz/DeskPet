<Window x:Class="DeskPet.Shell.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False">
    <Grid Background="{x:Null}">
        <Grid.RowDefinitions>
            <RowDefinition Height="110" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="ActionPanel"
                Grid.Row="0"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,4,0,0"
                Visibility="Collapsed"
                Background="#E61C1C1E"
                CornerRadius="12"
                BorderBrush="#33FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.4" />
            </Border.Effect>
            <StackPanel Margin="8,8">
                <TextBlock x:Name="StatsText"
                           Foreground="White"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="😺 ❤️ 100%  ✨ 100%" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button x:Name="PetButton" Click="PetButton_Click"
                            Content="抚摸" Width="44" Height="28" Margin="0,0,4,0"
                            Background="#FF5C8AD6" Foreground="White" BorderThickness="0"
                            FontSize="11" Cursor="Hand" />
                    <Button x:Name="ChatButton" Click="ChatButton_Click"
                            Content="对话" Width="44" Height="28" Margin="0,0,4,0"
                            Background="#FF7A5CD6" Foreground="White" BorderThickness="0"
                            FontSize="11" Cursor="Hand" />
                    <Button x:Name="HomeButton" Click="HomeButton_Click"
                            Content="回巢" Width="44" Height="28"
                            Background="#33333333" Foreground="White" BorderThickness="0"
                            FontSize="11" Cursor="Hand" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Image x:Name="FrameImage"
               Grid.Row="1"
               Stretch="Uniform"
               RenderTransformOrigin="0.5,0.5"
               Cursor="Hand" />

        <!-- Speech bubble (cloud-shaped): shows AI replies above the pet's head.
             Lives in Row 0 (the transparent strip above the pet) so it never
             covers the model. Wrapped in a Viewbox so the cloud scales down to
             fit the window width instead of being clipped on the right. -->
        <Viewbox x:Name="SpeechBubbleHost"
                 Grid.Row="0"
                 VerticalAlignment="Bottom"
                 HorizontalAlignment="Center"
                 Stretch="Uniform"
                 Visibility="Collapsed">
            <Canvas x:Name="SpeechBubble"
                    Width="300" Height="118"
                    IsHitTestVisible="False">
                <Canvas.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5" />
                </Canvas.Effect>
                <!-- Cloud body -->
                <Path Data="M 18,96 C 6,96 4,84 16,76 C 8,70 12,56 30,58 C 34,44 56,36 74,46 C 88,32 118,36 122,54 C 138,56 140,76 126,82 C 136,94 122,100 108,99 L 76,114 L 40,99 C 28,100 22,94 18,96 Z"
                      Fill="#FF23272F" Stroke="#66FFFFFF" StrokeThickness="1.5" IsHitTestVisible="False"/>
                <TextBlock x:Name="SpeechText"
                           Canvas.Left="24" Canvas.Top="30" Width="252"
                           Foreground="White" FontSize="12" TextWrapping="Wrap"
                           TextAlignment="Center" Text="…" IsHitTestVisible="False"/>
            </Canvas>
        </Viewbox>
    </Grid>
</Window>
