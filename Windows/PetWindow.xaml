<Window x:Class="DeskPet.Shell.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False">
    <Grid Background="{x:Null}">
        <Grid.RowDefinitions>
            <RowDefinition Height="110" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="ActionPanel"
                Grid.Row="0"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,4,0,0"
                Visibility="Collapsed"
                Background="#E61C1C1E"
                CornerRadius="12"
                BorderBrush="#33FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.4" />
            </Border.Effect>
            <StackPanel Margin="8,8">
                <TextBlock x:Name="StatsText"
                           Foreground="White"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="😺 ❤️ 100%  ✨ 100%" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button x:Name="PetButton" Click="PetButton_Click"
                            Content="抚摸" Width="44" Height="28" Margin="0,0,4,0"
                            Background="#FF5C8AD6" Foreground="White" BorderThickness="0"
                            FontSize="11" Cursor="Hand" />
                    <Button x:Name="ChatButton" Click="ChatButton_Click"
                            Content="对话" Width="44" Height="28" Margin="0,0,4,0"
                            Background="#FF7A5CD6" Foreground="White" BorderThickness="0"
                            FontSize="11" Cursor="Hand" />
                    <Button x:Name="HomeButton" Click="HomeButton_Click"
                            Content="回巢" Width="44" Height="28"
                            Background="#33333333" Foreground="White" BorderThickness="0"
                            FontSize="11" Cursor="Hand" />
                </StackPanel>

                <!-- Inline AI chat (replaces opening a separate ChatWindow). -->
                <StackPanel x:Name="ChatBox" Visibility="Collapsed" Margin="0,8,0,0" MinWidth="220">
                    <Border Background="#33111111" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                        <TextBlock x:Name="ChatReplyText" Foreground="White" FontSize="11"
                                   TextWrapping="Wrap" Text="想聊点什么呢？"/>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInput" Grid.Column="0"
                                 Background="#66000000" Foreground="White" BorderThickness="0"
                                 Padding="6,5" FontSize="12" AcceptsReturn="True"
                                 MaxHeight="70" VerticalScrollBarVisibility="Auto"
                                 KeyDown="ChatInput_KeyDown" />
                        <Button x:Name="ChatSendBtn" Grid.Column="1" Click="ChatSend_Click"
                                Content="发送" Width="48" Height="30" Margin="6,0,0,0"
                                Background="#FF7A5CD6" Foreground="White" BorderThickness="0"
                                FontSize="11" Cursor="Hand" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <Image x:Name="FrameImage"
               Grid.Row="1"
               Stretch="Uniform"
               RenderTransformOrigin="0.5,0.5"
               Cursor="Hand" />

        <!-- Speech bubble (cloud-shaped): shows AI replies above the pet's head.
             Lives in Row 0 (transparent strip above the pet) so it never covers
             the model. Self-sizes to its content at normal font size, centered. -->
        <Grid x:Name="SpeechBubble"
              Grid.Row="0"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="6,0,6,4"
              IsHitTestVisible="False"
              Visibility="Collapsed">
            <Grid.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" />
            </Grid.Effect>
            <StackPanel>
                <!-- Cloud body: rounded bubble -->
                <Border HorizontalAlignment="Center"
                        Background="#FF23272F"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1.5"
                        CornerRadius="18"
                        Padding="14,9"
                        MaxWidth="280">
                    <TextBlock x:Name="SpeechText"
                               Foreground="White"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Text="…" />
                </Border>
                <!-- Tail -->
                <Path Width="18" Height="10" Fill="#FF23272F"
                      Data="M 0,0 L 18,0 L 9,10 Z"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Stretch="Fill" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
