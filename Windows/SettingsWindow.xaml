<Window x:Class="DeskPet.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskPet 设置"
        Width="600" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E"
        Foreground="White">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C0C0C0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,12,0,3" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent">
            <!-- ============ 宠物 ============ -->
            <TabItem Header="宠物">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <CheckBox x:Name="PetEnabled" Content="启用桌面宠物" Foreground="#E0E0E0" />
                        <TextBlock Style="{StaticResource Hint}" Text="关闭后宠物会暂时消失，仍可通过屏幕上的圆形悬浮窗重新开启。" />

                        <TextBlock Text="宠物形象（模型）" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="PetModelCombo" Background="#FF2A2A2A" Foreground="White" BorderThickness="0" Padding="4" />
                        <TextBlock Style="{StaticResource Hint}" Text="选择要显示的宠物形象。皮肤来自内置模型与「图片\BoringPet\imported」中已导入的皮肤。" />

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="从文件夹导入皮肤…" Click="ImportFolder_Click" Margin="0,0,6,0"
                                    Background="#FF333333" Foreground="White" BorderThickness="0" FontSize="11" Padding="8,4" Cursor="Hand" />
                            <Button Content="从压缩包导入皮肤…" Click="ImportZip_Click"
                                    Background="#FF333333" Foreground="White" BorderThickness="0" FontSize="11" Padding="8,4" Cursor="Hand" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8" Text="导入自定义皮肤：一个含各动作子文件夹（idle、walk 等）的目录或 zip 包，可带 config.json 指定帧率与缩放。" />

                        <TextBlock Text="宠物大小（缩放）" Style="{StaticResource FieldLabel}" />
                        <Slider x:Name="PetScale" Minimum="0.3" Maximum="2.0" />
                        <TextBlock x:Name="PetScaleValue" Text="0.75×" Foreground="#909090" FontSize="11" HorizontalAlignment="Right" />
                        <TextBlock Style="{StaticResource Hint}" Text="宠物整体显示尺寸的缩放倍率：0.3 最小、2.0 最大，默认约 0.75。" />

                        <TextBlock Text="活动频率（秒）" Style="{StaticResource FieldLabel}" />
                        <Slider x:Name="RoamInterval" Minimum="5" Maximum="120" />
                        <TextBlock Style="{StaticResource Hint}" Text="宠物每隔这么多秒决定一次下一步做什么（走路、睡觉、发呆等）。数值越小宠物越活跃，越大越安静。" />

                        <TextBlock Text="属性衰减速度" Style="{StaticResource FieldLabel}" />
                        <Slider x:Name="StatDecay" Minimum="0.1" Maximum="2.0" />
                        <TextBlock Style="{StaticResource Hint}" Text="「心情 / 清洁度」随时间下降的速度倍率。数值越大下降越快；心情过低时戳它会出现委屈表情。" />

                        <CheckBox x:Name="MusicDance" Content="播放音乐时宠物跳舞" Foreground="#E0E0E0" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8" Text="检测到系统正在播放音乐时，宠物会跟着节奏摇摆起舞。" />

                        <TextBlock Text="动作音效音量" Style="{StaticResource FieldLabel}" />
                        <Slider x:Name="SoundVolume" Minimum="0" Maximum="1" />
                        <TextBlock Style="{StaticResource Hint}" Text="宠物动作音效（叫声等）的音量，0 = 静音，1 = 最大。" />

                        <TextBlock Text="皮肤目录（留空则用默认）" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SkinDirectory" Background="#FF2A2A2A" Foreground="White" BorderThickness="0" Padding="4" />
                        <TextBlock Style="{StaticResource Hint}" Text="自定义皮肤所在目录；留空则使用内置与已导入的皮肤。" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ AI 对话 ============ -->
            <TabItem Header="AI 对话">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                    <TextBlock Text="服务商" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="AiProviderCombo" Background="#FF2A2A2A" Foreground="White" BorderThickness="0" Padding="4"
                              SelectionChanged="AiProvider_SelectionChanged">
                        <ComboBoxItem Content="DeepSeek" Tag="deepseek" />
                        <ComboBoxItem Content="OpenAI" Tag="openai" />
                        <ComboBoxItem Content="自定义" Tag="custom" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource Hint}" Text="宠物「对话」功能使用的大模型服务商，可选择 DeepSeek、OpenAI，或自定义任何 OpenAI 兼容接口。" />
                    <TextBlock Text="API 密钥" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="AiApiKey" Background="#FF2A2A2A" Foreground="White" BorderThickness="0" Padding="4" />
                    <TextBlock Style="{StaticResource Hint}" Text="服务商提供的 API 密钥，用于调用对话接口。密钥仅保存在本机设置文件中。" />
                    <TextBlock Text="模型" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="AiModel" Background="#FF2A2A2A" Foreground="White" BorderThickness="0" Padding="4" />
                    <TextBlock Style="{StaticResource Hint}" Text="要调用的模型名称，例如 deepseek-chat、gpt-4o-mini。切换服务商时默认模型会自动更新。" />
                    <TextBlock Text="接口地址（Base URL）" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="AiBaseUrl" Background="#FF2A2A2A" Foreground="White" BorderThickness="0" Padding="4" />
                    <TextBlock Style="{StaticResource Hint}" Text="API 的基础地址。DeepSeek / OpenAI 会自动填写，只有选择「自定义」时才需要手动输入。" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 行为 ============ -->
            <TabItem Header="行为">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                    <CheckBox x:Name="EnableHaptics" Content="启用触觉反馈" Foreground="#E0E0E0" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8" Text="交互时触发轻微的震动反馈（需要设备支持）。" />
                    <CheckBox x:Name="AutoStartOnBoot" Content="开机自启动" Foreground="#E0E0E0" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8" Text="勾选后，登录 Windows 会自动启动 DeskPet（写入注册表启动项）。" />
                    <CheckBox x:Name="PetClickThrough" Content="宠物鼠标穿透（点不到宠物，点击穿透到后面）" Foreground="#E0E0E0" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8" Text="开启后宠物不再响应鼠标点击，点击会直接落在宠物背后的窗口上；关闭后可正常点击互动。" />

                    <TextBlock Text="悬浮窗大小（缩放）" Style="{StaticResource FieldLabel}" />
                    <Slider x:Name="FloatScale" Minimum="0.5" Maximum="2.5" />
                    <TextBlock x:Name="FloatScaleValue" Text="1.0×" Foreground="#909090" FontSize="11" HorizontalAlignment="Right" />
                    <TextBlock Style="{StaticResource Hint}" Text="圆形悬浮窗（灵动岛）的显示尺寸：0.5 最小、2.5 最大。拖动它可移动位置，单击展开功能菜单。" />

                    <TextBlock Text="悬浮窗透明度" Style="{StaticResource FieldLabel}" />
                    <Slider x:Name="FloatOpacity" Minimum="0.2" Maximum="1.0" />
                    <TextBlock x:Name="FloatOpacityValue" Text="95%" Foreground="#909090" FontSize="11" HorizontalAlignment="Right" />
                    <TextBlock Style="{StaticResource Hint}" Text="圆形悬浮窗的透明度，数值越小越透明（0.2 = 几乎透明，1.0 = 完全不透明）。" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 动作 ============ -->
            <TabItem Header="动作">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="自动动作触发概率（加权随机，按比例分配，无需加起来等于100%）" Foreground="#FFFFFF" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Hint}" Text="宠物每次决定下一步时，会按下面四个数值的比例随机选一种行为。例如「走路 0.2 / 睡觉 0.12 / 小动作 0.1 / 待机 0.58」，数值越大越常出现；某项设为 0 则永不触发。" />

                        <TextBlock Text="走路概率" Style="{StaticResource FieldLabel}" />
                        <Slider x:Name="AiWalkChance" Minimum="0" Maximum="1" />
                        <TextBlock x:Name="AiWalkValue" Text="20%" Foreground="#909090" FontSize="11" HorizontalAlignment="Right" />

                        <TextBlock Text="睡觉概率" Style="{StaticResource FieldLabel}" />
                        <Slider x:Name="AiSleepChance" Minimum="0" Maximum="1" />
                        <TextBlock x:Name="AiSleepValue" Text="12%" Foreground="#909090" FontSize="11" HorizontalAlignment="Right" />

                        <TextBlock Text="小动作概率（哈欠/开心/委屈）" Style="{StaticResource FieldLabel}" />
                        <Slider x:Name="AiActionChance" Minimum="0" Maximum="1" />
                        <TextBlock x:Name="AiActionValue" Text="10%" Foreground="#909090" FontSize="11" HorizontalAlignment="Right" />

                        <TextBlock Text="待机概率（安静站着）" Style="{StaticResource FieldLabel}" />
                        <Slider x:Name="AiIdleChance" Minimum="0" Maximum="1" />
                        <TextBlock x:Name="AiIdleValue" Text="58%" Foreground="#909090" FontSize="11" HorizontalAlignment="Right" />

                        <TextBlock Text="各动作播放速度倍率（1.0 = 原速）" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,18,0,0" />
                        <TextBlock Style="{StaticResource Hint}" Text="调节每个动作动画的播放速度：大于 1.0 更快，小于 1.0 更慢。用于让某些动作看起来更自然。" />

                        <StackPanel x:Name="ActionSpeedPanel" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存" Click="Save_Click" Width="90" Height="30" Background="#FF5C8AD6" Foreground="White" BorderThickness="0" Cursor="Hand" />
            <Button Content="关闭" Click="Close_Click" Width="90" Height="30" Margin="8,0,0,0" Background="#FF333333" Foreground="White" BorderThickness="0" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
