<Window x:Class="DeskPet.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskPet Settings"
        Width="560" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E"
        Foreground="White">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0" />
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent">
            <TabItem Header="Pet">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <CheckBox x:Name="PetEnabled" Content="Enable desktop pet" />
                        <TextBlock Text="Pet model" Margin="0,8,0,2" />
                        <ComboBox x:Name="PetModelCombo" Background="#FF2A2A2A" Foreground="White" BorderThickness="0" Padding="4" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Import skin (folder)" Click="ImportFolder_Click" Margin="0,0,6,0"
                                    Background="#FF333333" Foreground="White" BorderThickness="0" FontSize="11" Padding="8,4" Cursor="Hand" />
                            <Button Content="Import skin (zip)" Click="ImportZip_Click"
                                    Background="#FF333333" Foreground="White" BorderThickness="0" FontSize="11" Padding="8,4" Cursor="Hand" />
                        </StackPanel>
                        <TextBlock Text="Pet scale" Margin="0,10,0,2" />
                        <Slider x:Name="PetScale" Minimum="0.3" Maximum="2.0" />
                        <TextBlock Text="Activity interval (seconds)" Margin="0,10,0,2" />
                        <Slider x:Name="RoamInterval" Minimum="5" Maximum="120" />
                        <TextBlock Text="Stat decay speed" Margin="0,10,0,2" />
                        <Slider x:Name="StatDecay" Minimum="0.1" Maximum="2.0" />
                        <CheckBox x:Name="MusicDance" Content="Dance while music is playing" />
                        <TextBlock Text="Sound volume" Margin="0,10,0,2" />
                        <Slider x:Name="SoundVolume" Minimum="0" Maximum="1" />
                        <TextBlock Text="Skin folder (empty = default ~/Pictures/BoringPet)" Margin="0,10,0,2" />
                        <TextBox x:Name="SkinDirectory" Background="#FF2A2A2A" Foreground="White" BorderThickness="0" Padding="4" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="AI">
                <StackPanel Margin="12">
                    <TextBlock Text="Provider" />
                    <ComboBox x:Name="AiProviderCombo" Background="#FF2A2A2A" Foreground="White" BorderThickness="0" Padding="4"
                              SelectionChanged="AiProvider_SelectionChanged">
                        <ComboBoxItem Content="DeepSeek" Tag="deepseek" />
                        <ComboBoxItem Content="OpenAI" Tag="openai" />
                        <ComboBoxItem Content="Custom" Tag="custom" />
                    </ComboBox>
                    <TextBlock Text="API Key" Margin="0,10,0,2" />
                    <TextBox x:Name="AiApiKey" Background="#FF2A2A2A" Foreground="White" BorderThickness="0" Padding="4" />
                    <TextBlock Text="Model" Margin="0,10,0,2" />
                    <TextBox x:Name="AiModel" Background="#FF2A2A2A" Foreground="White" BorderThickness="0" Padding="4" />
                    <TextBlock Text="Base URL" Margin="0,10,0,2" />
                    <TextBox x:Name="AiBaseUrl" Background="#FF2A2A2A" Foreground="White" BorderThickness="0" Padding="4" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Behavior">
                <StackPanel Margin="12">
                    <CheckBox x:Name="EnableHaptics" Content="Enable haptic feedback" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Click="Save_Click" Width="90" Height="30" Background="#FF5C8AD6" Foreground="White" BorderThickness="0" Cursor="Hand" />
            <Button Content="Close" Click="Close_Click" Width="90" Height="30" Margin="8,0,0,0" Background="#FF333333" Foreground="White" BorderThickness="0" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
